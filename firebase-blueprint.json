{
  "entities": {
    "Prediction": {
      "title": "Prediction",
      "description": "Stock recommendation signal generated by swing strategy algorithms",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 100 },
        "strategy": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 30 },
        "recommendedDate": { "type": "string", "maxLength": 30 },
        "recommendedPrice": { "type": "number" },
        "targetPrice": { "type": "number" },
        "stopLossPrice": { "type": "number" },
        "targetPercent": { "type": "number" },
        "stopLossPercent": { "type": "number" },
        "holdingDaysMax": { "type": "number" },
        "isWin": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "symbol", "strategy", "status", "recommendedDate", "recommendedPrice", "targetPrice", "stopLossPrice"]
    },
    "Trade": {
      "title": "Trade",
      "description": "Executed swing trading paper orders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "symbol": { "type": "string", "maxLength": 30 },
        "action": { "type": "string", "maxLength": 10 },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "status": { "type": "string", "maxLength": 20 },
        "target": { "type": "number" },
        "stopLoss": { "type": "number" },
        "strategy": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "symbol", "action", "quantity", "price", "status"]
    }
  },
  "firestore": {
    "/predictions/{predictionId}": {
      "schema": "Prediction",
      "description": "Historical and active swing trading predictions with verified win/loss outcomes"
    },
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "Automated paper portfolio execution journal"
    }
  }
}
